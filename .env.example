# Copie este arquivo para ".env" (na mesma pasta) e preencha com as
# connection strings do MongoDB Atlas que a Pessoa 3 enviou no grupo.
# NUNCA envie o arquivo .env para o GitHub.
#
# Cada serviço usa um usuário próprio, com acesso apenas ao seu banco.
# Se a senha tiver caracteres especiais (@ : / ? # %), troque-a por uma sem
# esses caracteres ou codifique-os (ex.: @ vira %40).

ANIMAIS_MONGODB_URI=mongodb+srv://svc_animais:SENHA_AQUI@CLUSTER_AQUI.mongodb.net/?retryWrites=true&w=majority&appName=AdotaPet
ADOTANTES_MONGODB_URI=mongodb+srv://svc_adotantes:SENHA_AQUI@CLUSTER_AQUI.mongodb.net/?retryWrites=true&w=majority&appName=AdotaPet
ADOCOES_MONGODB_URI=mongodb+srv://svc_adocoes:SENHA_AQUI@CLUSTER_AQUI.mongodb.net/?retryWrites=true&w=majority&appName=AdotaPet
